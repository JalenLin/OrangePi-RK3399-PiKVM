#!/usr/bin/env bash
# Copy the running SD installation onto this board's eMMC.
#
# The other way round - build an eMMC image on a host and write it here - is
# one dd, and docs/emmc.md has it. This exists for the case that has no build
# machine in it: flash a card, configure the board, then move the result onto
# eMMC and take the card out.
#
# It is the vendor's install_to_emmc (external/install_to_emmc) rewritten for
# this image's layout, which differs in three ways that matter: a 128 MiB boot
# partition rather than 32 MiB, a fifth partition for the MSD store, and an
# /etc/fstab that names partitions by GUID and so has to be rewritten.
set -euo pipefail

die()  { printf '\033[1;31mXX\033[0m %s\n' "$*" >&2; exit 1; }
msg()  { printf '\033[1;34m::\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$*" >&2; }

ASSUME_YES=0
[[ "${1:-}" == "-y" || "${1:-}" == "--yes" ]] && ASSUME_YES=1

(( EUID == 0 )) || die "must be run as root"

# --- the GUIDs, which are the whole reason this is not a plain disk copy ----
#
# The BSP U-Boot decides root= from the medium it booted off, and it does it
# with a hardcoded thirteen-character prefix (common/boot_rkimg.c):
#
#     emmc -> root=PARTUUID=615e0000-0000
#     else -> root=PARTUUID=614e0000-0000
#
# So the eMMC copy cannot keep the card's GUIDs. It also must not: the kernel
# matches PARTUUID by prefix, over every block device it can see, so two media
# in one board carrying the same prefix is a coin toss over which rootfs gets
# mounted. Same reasoning in config/board.conf.
EMMC_ROOT_UUID="615e0000-0000-4b53-8000-1d28000054a9"
EMMC_MSD_UUID="615e0000-0000-4b53-8000-1d28000054aa"

# --- work out which device is which ----------------------------------------
root_src="$(findmnt -no SOURCE /)"
case "${root_src}" in
    /dev/mmcblk*p[0-9]*) src_disk="${root_src%p[0-9]*}" ;;
    *) die "root is ${root_src}, which is not an mmcblk partition" ;;
esac

# Only eMMC has hardware boot partitions, so boot0 is what identifies it - not
# the device number, and not "the one that is not root".
emmc=""
for d in /dev/mmcblk[0-9]; do
    [[ -b "${d}boot0" ]] && emmc="${d}" && break
done
[[ -n "${emmc}" ]] || die "no eMMC on this board (no /dev/mmcblk*boot0)"
[[ "${emmc}" != "${src_disk}" ]] || die "already running from eMMC (${emmc})"

msg "source: ${src_disk} (running system, root on ${root_src})"
msg "target: ${emmc} ($(lsblk -dno SIZE "${emmc}" | tr -d ' '))"

# --- read the layout off the running card, rather than restating it --------
# config/board.conf owns these numbers. Reading them back from the card that
# was built with them means this script cannot drift away from it.
declare -A P_START P_SIZE P_NAME
while read -r dev _ rest; do
    [[ "${dev}" == "${src_disk}"p[0-9]* ]] || continue
    n="${dev##*p}"
    P_START[$n]="$(sed -n 's/.*start=[[:space:]]*\([0-9]*\).*/\1/p' <<<"${rest}")"
    P_SIZE[$n]="$(sed -n 's/.*size=[[:space:]]*\([0-9]*\).*/\1/p' <<<"${rest}")"
    P_NAME[$n]="$(sed -n 's/.*name="\([^"]*\)".*/\1/p' <<<"${rest}")"
done < <(sfdisk --dump "${src_disk}")

for n in 1 2 3 4 5; do
    [[ -n "${P_START[$n]:-}" ]] || die "${src_disk} has no partition ${n} - is this a PiKVM card?"
done

# Everything from the first loader sector up to the end of the boot partition
# is raw: idbloader at 64, then the uboot, trust and boot partitions, none of
# them a filesystem. It copies as one block, and starting at 64 steps over the
# GPT - which must not be copied, since the target is a different size and
# needs different GUIDs.
head_start=64
head_end=$(( P_START[3] + P_SIZE[3] ))          # exclusive
emmc_sectors=$(( $(blockdev --getsize64 "${emmc}") / 512 ))
(( emmc_sectors > P_START[5] + 65536 )) || die "eMMC is too small for this layout"

cat <<INFO

  raw head   sectors ${head_start}..$(( head_end - 1 ))  (loader, uboot, trust, boot)
  rootfs     $(( P_SIZE[4] / 2048 )) MiB, copied file by file, GUID ${EMMC_ROOT_UUID}
  msd store  the rest of the eMMC, empty, GUID ${EMMC_MSD_UUID}

INFO

if (( ! ASSUME_YES )); then
    warn "EVERYTHING ON ${emmc} WILL BE DESTROYED - it currently holds $(
            sfdisk --dump "${emmc}" >/dev/null 2>&1 && echo "a partition table" \
            || echo "the factory Android firmware")."
    read -rp "Type YES to continue: " a
    [[ "${a}" == YES ]] || { echo "cancelled."; exit 1; }
fi

# --- go --------------------------------------------------------------------
for n in "${emmc}"p*; do
    [[ -b "${n}" ]] && umount -l "${n}" 2>/dev/null || true
done

msg "clearing the old partition table"
# The factory image has no GPT at all - it has a Rockchip parameter block at
# sector 8192 - so there is nothing for sfdisk to delete. wipefs is what
# actually removes it, and the loader area has to go too or the board would
# chain the Android loader we are about to write over anyway.
wipefs -aq "${emmc}" >/dev/null 2>&1 || true
dd if=/dev/zero of="${emmc}" bs=1M count=32 conv=fsync status=none

msg "writing the partition table"
{
    echo 'label: gpt'
    echo 'unit: sectors'
    for n in 1 2 3 4; do
        printf 'start=%s, size=%s, name="%s"' \
               "${P_START[$n]}" "${P_SIZE[$n]}" "${P_NAME[$n]}"
        case "${n}" in
            4) printf ', uuid=%s' "${EMMC_ROOT_UUID}" ;;
        esac
        echo
    done
    # No size: the last partition takes whatever the eMMC has left, so the MSD
    # store is sized here and never needs expand-msd.sh on this medium.
    printf 'start=%s, name="%s", uuid=%s\n' \
           "${P_START[5]}" "${P_NAME[5]}" "${EMMC_MSD_UUID}"
} | sfdisk --quiet --force --wipe always "${emmc}"
partx -u "${emmc}" >/dev/null 2>&1 || true
udevadm settle 2>/dev/null || true

msg "copying the raw boot chain ($(( (head_end - head_start) / 2048 )) MiB)"
dd if="${src_disk}" of="${emmc}" skip="${head_start}" seek="${head_start}" \
   count=$(( head_end - head_start )) bs=512 conv=fsync status=none

msg "making filesystems"
# Same options mkimage.sh uses: ^metadata_csum is what the vendor U-Boot and
# this kernel can read back.
mkfs.ext4 -q -F -O ^metadata_csum -b 4096 -L rootfs "${emmc}p4"
mkfs.ext4 -q -F -O ^metadata_csum -b 4096 -L MSD    "${emmc}p5"

mnt="$(mktemp -d)"
trap 'umount -R "${mnt}" 2>/dev/null || true; rmdir "${mnt}" 2>/dev/null || true' EXIT
mount "${emmc}p4" "${mnt}"

msg "copying the root filesystem - this is the slow part"
# tar rather than rsync, which this image does not ship. --one-file-system is
# what keeps /proc, /sys, /run, /dev and the MSD mount out; their mountpoints
# still get created, because the directories themselves are on the root fs.
#
# Exit 1 from the reading tar is accepted, and it has to be: cloning a running
# system means files change under it, and tar answers that with "file changed
# as we read it" and exit 1. With set -e and pipefail that killed the script
# here on the first run - after the copy, before the fstab rewrite, leaving an
# eMMC that looked finished and would have mounted the card's root. Only exit
# 2 is a real failure. The receiving tar gets no such licence.
set +e
tar -C / --one-file-system --numeric-owner --xattrs --acls -cf - . \
    | tar -C "${mnt}" --numeric-owner --xattrs --acls -xf -
rc=( "${PIPESTATUS[@]}" )
set -e
(( rc[0] <= 1 )) || die "reading the root filesystem failed (tar exit ${rc[0]})"
(( rc[1] == 0 )) || die "writing to the eMMC failed (tar exit ${rc[1]})"
(( rc[0] == 0 )) || warn "tar reported files that changed while it read them; that is"
(( rc[0] == 0 )) || warn "normal on a running system, and the warnings above name them."

msg "pointing /etc/fstab at the eMMC's partitions"
# Both lines name a partition by GUID, and both GUIDs just changed. Without
# this the board would mount the *card's* MSD store when one is present, and
# fail the mount when one is not.
sed -i 's/614e0000-0000-4b53-8000-1d280000/615e0000-0000-4b53-8000-1d280000/g' \
    "${mnt}/etc/fstab"
grep -q "${EMMC_ROOT_UUID}" "${mnt}/etc/fstab" || die "fstab rewrite did not take"

# The MSD partition was created at its final size above, so first boot has
# nothing to expand. Say so, or expand-msd.sh runs once on the eMMC and fails
# noisily trying to grow a partition that already ends at the last sector.
mkdir -p "${mnt}/var/lib/pikvm"
touch "${mnt}/var/lib/pikvm/.msd-expanded"

sync
umount -R "${mnt}"

cat <<'DONE'

:: done.

   Power the board off, take the SD card out, and power it back on. The card
   has to come out: the BSP U-Boot prefers it whenever one is present, so with
   a card in the slot the eMMC's root filesystem is never reached.

   To confirm afterwards, `cat /proc/cmdline` should say storagemedia=emmc.

DONE
