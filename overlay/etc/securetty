# File which lists terminals from which root can log in.
# See securetty(5) for details.

console
tty1
tty2
tty3
tty4
tty5
tty6
ttyS0
hvc0

# ttyS2 is this board's debug UART and the only console it has before the
# network is up. pam_securetty refuses root on any tty missing from this
# file, and does it with the same "Login incorrect" it uses for a wrong
# password - so the board looked like it was rejecting a password that was
# provably correct.
ttyS2
