[Unit]
Description=PiKVM - grow the MSD partition to fill the card (first boot)
DefaultDependencies=no
After=systemd-remount-fs.service
Before=local-fs.target var-lib-kvmd-msd.mount kvmd.service
# ...and before the MSD's fsck, which is the ordering that actually matters.
# Both this unit and systemd-fsck@ are merely "before the mount", which left
# them free to race - and they did, on every first boot: sfdisk rewrites the
# GPT, partx -u makes udev tear down and recreate /dev/disk/by-partuuid/*, and
# fsck fired inside that window with "Failed to stat ...: No such file or
# directory". The mount then never ran, so kvmd reported storage: null and
# error-looped on the remount helper until the next reboot.
#
# The names are the escaped forms of /dev/disk/by-partuuid/<MSD_PART_UUID>,
# and they are hardcoded because that GUID is: config/board.conf pins it and
# /etc/fstab names the partition by it.
#
# Both media are listed because the GUID is what tells them apart - 614e on an
# SD card, 615e on eMMC, a distinction the vendor U-Boot forces on us (see the
# comment in board.conf). Only one of these units will ever exist on a given
# board. Naming the other one costs nothing: Before= on a unit that does not
# exist is ordering against nothing, not an error, and it keeps this file the
# same on both images.
Before=systemd-fsck@dev-disk-by\x2dpartuuid-614e0000\x2d0000\x2d4b53\x2d8000\x2d1d28000054aa.service
Before=systemd-fsck@dev-disk-by\x2dpartuuid-615e0000\x2d0000\x2d4b53\x2d8000\x2d1d28000054aa.service
ConditionPathExists=!/var/lib/pikvm/.msd-expanded

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/pikvm/expand-msd.sh
ExecStartPost=/usr/bin/mkdir -p /var/lib/pikvm
ExecStartPost=/usr/bin/touch /var/lib/pikvm/.msd-expanded

[Install]
WantedBy=sysinit.target
