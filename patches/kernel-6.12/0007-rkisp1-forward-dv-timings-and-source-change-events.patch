+/*
+ * Relay subdev events to the capture video nodes.
+ *
+ * v4l2_subdev_notify_event() queues the event on the subdev's own node and
+ * then calls this. Without it, V4L2_EVENT_SOURCE_CHANGE from the HDMI bridge
+ * only ever reached /dev/v4l-subdev2, and a client watching /dev/video0 - which
+ * is the only node ustreamer opens - never learned that the source had changed
+ * resolution.
+ */
+static void rkisp1_subdev_notify(struct v4l2_subdev *sd, unsigned int notification,
+				 void *arg)
+{
+	struct rkisp1_device *dev =
+		container_of(sd->v4l2_dev, struct rkisp1_device, v4l2_dev);
+	unsigned int i;
+
+	if (notification != V4L2_DEVICE_NOTIFY_EVENT)
+		return;
+
+	for (i = 0; i < RKISP1_MAX_STREAM; i++) {
+		struct video_device *vdev = &dev->stream[i].vnode.vdev;
+
+		if (video_is_registered(vdev))
+			v4l2_event_queue(vdev, arg);
+	}
+}
+
