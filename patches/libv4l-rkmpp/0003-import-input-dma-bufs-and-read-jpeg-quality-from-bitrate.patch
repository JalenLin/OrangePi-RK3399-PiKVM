diff --git a/src/utils.c b/src/utils.c
index b88a276..56e7dec 100644
--- a/src/utils.c
+++ b/src/utils.c
@@ -13,9 +13,80 @@
  */
 
 #include <sys/mman.h>
+#include <unistd.h>
 
 #include "libv4l-rkmpp.h"
 
+void rkmpp_release_import(struct rkmpp_buffer *rkmpp_buffer)
+{
+	if (!rkmpp_buffer->import_buf)
+		return;
+
+	mpp_buffer_put(rkmpp_buffer->import_buf);
+	rkmpp_buffer->import_buf = NULL;
+}
+
+/*
+ * Hand the caller's dma-buf to MPP as it is, instead of mapping it and
+ * copying it into one of our own buffers.
+ *
+ * The copy is the expensive part of this plugin by a wide margin. A capture
+ * buffer exported by a non-coherent device is mapped uncached, so the CPU
+ * reads it at a fraction of normal memory speed: a 1080p YUYV frame is 4 MB,
+ * and copying it out cost ~27 ms of a core per frame on RK3399 - more than
+ * the encoder spent on the frame. The hardware does not need any of that.
+ * VEPU2 reads its input by fd through its own IOMMU, and MPP's EXT_DMA
+ * allocator only maps a buffer if somebody asks for a CPU pointer, which the
+ * encoder path does not.
+ *
+ * The buffer has to cover what the hardware reads, not what the frame
+ * holds, and those differ. VEPU2 reads whole macroblock rows, so a 1080-line
+ * frame is fetched as 1088 lines: given a buffer of exactly 1080, the last
+ * row runs off the end and the encoder's IOMMU faults on the first address
+ * past it (measured: a read at buffer + 1081 * stride, then a hung VPU and a
+ * reset). Our own buffers are sized from the macroblock-rounded format, so
+ * the copy never had this problem. Import only a dma-buf at least that big;
+ * anything smaller - which is every capture buffer that is sized to its
+ * frame exactly - is copied as before.
+ *
+ * Returns 0 when imported, -1 to fall back to copying.
+ */
+static int rkmpp_import_dmabuf(struct rkmpp_buf_queue *queue,
+			       struct rkmpp_buffer *rkmpp_buffer)
+{
+	int fd = rkmpp_buffer->planes[0].fd;
+	uint32_t need = queue->format.plane_fmt[0].sizeimage;
+	MppBufferInfo info;
+	off_t size;
+
+	rkmpp_release_import(rkmpp_buffer);
+
+	size = lseek(fd, 0, SEEK_END);
+	if (size <= 0 || (uint64_t)size < need) {
+		if (!queue->import_refused)
+			LOG("dma-buf %d is %ld bytes, the encoder reads %u: "
+			    "copying instead\n", fd, (long)size, need);
+		queue->import_refused = true;
+		return -1;
+	}
+
+	memset(&info, 0, sizeof(info));
+	info.type = MPP_BUFFER_TYPE_EXT_DMA;
+	info.fd = fd;
+	info.size = size;
+	info.index = rkmpp_buffer->index;
+
+	if (mpp_buffer_import(&rkmpp_buffer->import_buf, &info) != MPP_OK) {
+		LOGE("failed to import dma-buf %d\n", fd);
+		rkmpp_buffer->import_buf = NULL;
+		return -1;
+	}
+
+	LOGV(2, "imported dma-buf %d (%ld bytes) for buffer %d\n",
+	     fd, (long)size, rkmpp_buffer->index);
+	return 0;
+}
+
 static int rkmpp_copy_buffer(struct rkmpp_context *ctx,
 			     struct rkmpp_buffer *rkmpp_buffer,
 			     struct v4l2_buffer *buffer, int copy_to)
@@ -42,6 +113,16 @@ static int rkmpp_copy_buffer(struct rkmpp_context *ctx,
 	if (!queue)
 		return -1;
 
+	/* Raw frames into an encoder: let the hardware read them in place. */
+	if (!copy_to && buffer->memory == V4L2_MEMORY_DMABUF &&
+	    !ctx->is_decoder && ctx->import_dmabuf &&
+	    queue == &ctx->output && buffer->length == 1 &&
+	    !rkmpp_buffer->planes[0].data_offset &&
+	    !rkmpp_import_dmabuf(queue, rkmpp_buffer)) {
+		LEAVE();
+		return 0;
+	}
+
 	rkmpp_ptr = mpp_buffer_get_ptr(rkmpp_buffer->rkmpp_buf);
 
 	/* Prepare access */
