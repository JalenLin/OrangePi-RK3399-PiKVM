+/*
+ * Recover the JPEG quality a client meant from the bitrate it sent.
+ *
+ * ustreamer has two ways to drive a hardware JPEG encoder and they differ in
+ * exactly the wrong place. --encoder=m2m-image sets
+ * V4L2_CID_JPEG_COMPRESSION_QUALITY but always copies each frame into the
+ * encoder's buffer; --encoder=m2m-video hands over the capture dma-buf
+ * instead, which is what lets the VPU read the frame in place, but has no
+ * quality control at all - it turns --quality into a bitrate and sends
+ * V4L2_CID_MPEG_VIDEO_BITRATE. The quality factor here is pinned (see
+ * rkmpp_enc_apply_mjpeg_cfg), so that bitrate does nothing, and every
+ * --quality became 80: kvmd's quality setting silently stopped working.
+ *
+ * The conversion is deterministic - us_m2m_mjpeg_encoder_init() in
+ * ustreamer's src/ustreamer/m2m.c - and one-to-one over 1..100, so the
+ * quality can be read back out. Rather than invert it in floating point,
+ * run it forward for every quality and accept only an exact match. A
+ * bitrate that matches nothing - a different client, or a ustreamer that
+ * changed its formula - leaves the quality alone instead of guessing.
+ */
+static int rkmpp_mjpeg_quality_from_bitrate(int bitrate)
+{
+	const double b_min = 25, b_max = 20000, step = 25;
+	int quality;
+
+	for (quality = 1; quality <= 100; quality++) {
+		double kbps = log10(quality) * (b_max - b_min) / 2 + b_min;
+
+		kbps = step * round(kbps / step);
+		if ((int)(kbps * 1000) == bitrate)
+			return quality;
+	}
+
+	return 0;
+}
