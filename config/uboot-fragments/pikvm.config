# Merged on top of orangepi-rk3399_defconfig. Two lines, both about fitting
# mainline U-Boot into a layout and a board that were already decided.

# Where SPL looks for u-boot.itb. Mainline's Rockchip default is 0x4000
# (sector 16384), which is the offset mainline's own PARTS_DEFAULT reserves.
# This image uses the vendor SDK's layout instead, where sector 24576 is the
# start of the "uboot" partition - 4 MiB of it, against an itb of about 1.2.
# Pointing SPL at the partition that already exists is one line; moving the
# partition would move the eMMC images, the GUID scheme, expand-msd.sh and
# every sector in docs/image-layout.md.
CONFIG_SYS_MMCSD_RAW_MODE_U_BOOT_SECTOR=0x6000

# 1500000 is what every RK3399 defconfig ships and what the BSP U-Boot uses.
# On this board's wiring it reads fine and corrupts on write, so a console at
# that rate is one you cannot type on. The kernel is already at 115200
# (bootargs in the board DTS); this makes the whole boot one rate.
CONFIG_BAUDRATE=115200
