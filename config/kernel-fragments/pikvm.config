# Kconfig fragment merged on top of the vendor rk3399_linux_defconfig.
# Everything PiKVM needs that the vendor defconfig does not already enable.

# --- HDMI IN capture -------------------------------------------------------
# tc35874x is the vendor's port of mainline's tc358743 driver, extended to
# cover the TC358749XBG on this board. The board DTS selects it via
# compatible = "toshiba,tc358749".
CONFIG_VIDEO_TC35874X=y

# Rockchip's 6.12 tree ships three ISP drivers and they are mutually
# exclusive - enabling two collides at link time on rkisp1_isp_isr:
#
#   isp/     VIDEO_ROCKCHIP_ISP     RK3562/68/76/88 only - not our SoC
#   isp1/    VIDEO_ROCKCHIP_RKISP1  "rockchip,rk3399-rkisp1"   <- vendor
#   rkisp1/  VIDEO_ROCKCHIP_ISP1    "rockchip,rk3399-cif-isp"  <- mainline
#
# We take the vendor one: it is what the working 4.4 HDMI-IN device tree
# bound to, so it is the shortest path to a picture. The mainline driver
# stays a deliberate later experiment - it is the one carrying the unresolved
# YUV422-at-1080p60 bandwidth question. Switching tracks means flipping these
# two symbols and rewriting the DTS graph, since the two bindings describe
# the dphy differently.
CONFIG_VIDEO_ROCKCHIP_RKISP1=y
# CONFIG_VIDEO_ROCKCHIP_ISP1 is not set
CONFIG_VIDEO_V4L2_SUBDEV_API=y
CONFIG_MEDIA_CONTROLLER=y
CONFIG_V4L2_FWNODE=y
CONFIG_VIDEO_V4L2=y
CONFIG_VIDEOBUF2_DMA_CONTIG=y

# --- USB gadget: keyboard + mouse ------------------------------------------
# THE critical gap in the vendor defconfig. Without F_HID there is no HID
# gadget, and without a HID gadget PiKVM cannot type or move the mouse - the
# capture side would work and the KVM would still be useless.
CONFIG_USB_CONFIGFS_F_HID=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_F_HID=y

# --- USB gadget: virtual media (mass storage) ------------------------------
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_F_MASS_STORAGE=y

# --- USB gadget: optional ethernet + serial to the target ------------------
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ACM=y

# --- USB gadget: audio passthrough (PiKVM v3 style) ------------------------
CONFIG_USB_CONFIGFS_F_UAC2=y
CONFIG_USB_F_UAC2=y

# --- ATX control via GPIO --------------------------------------------------
CONFIG_GPIO_SYSFS=y

# --- Misc PiKVM runtime ----------------------------------------------------
CONFIG_CIFS=m
CONFIG_NFS_FS=m
CONFIG_TUN=m

# --- HDMI console: the second pair of eyes ------------------------------
# Not cosmetic. When the serial console drops out - and during bring-up it
# does - a black screen leaves no way to tell a hung board from a board that
# is running fine but has stopped talking to us. Two independent channels
# make that difference observable.
#
# rockchip_linux_defconfig leaves all of this off: no CONFIG_FB, no fbdev
# emulation, and not even the HDMI encoder driver, so console=tty1 (which is
# what U-Boot puts in the bootargs) has nothing to render to.
CONFIG_DRM_ROCKCHIP=y
CONFIG_ROCKCHIP_DW_HDMI=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y

# --- Serial console ------------------------------------------------------
# U-Boot hands this kernel "console=tty1 console=ttyFIQ0". ttyFIQ0 comes from
# Rockchip's FIQ debugger, whose driver is built in here but whose device
# tree node exists only in the 4.4 tree - so on a 6.12 device tree the kernel
# boots, or fails to, in complete silence on both serial and HDMI.
#
# The node is restored in patches/kernel-6.12; these just make sure the
# drivers behind both consoles are present. (CONFIG_CMDLINE_EXTEND would have
# been the tidier fix, but arm64 dropped that option - only
# CMDLINE_FROM_BOOTLOADER and CMDLINE_FORCE remain, and FORCE would throw
# away the root= that U-Boot supplies.)
CONFIG_ROCKCHIP_FIQ_DEBUGGER=y
CONFIG_FIQ_DEBUGGER_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_8250_CONSOLE=y

# --- Rockchip cpufreq: module, not built-in --------------------------------
# Built as a module so it can be loaded by hand *after* the rootfs is up.
# That is the whole point of =m here, and it is worth stating plainly.
#
# The history: with this built in, it oopsed once the RK808 regulators bound
# and it stopped deferring:
#
#   Internal error: Oops: ... pc : rockchip_pll_clk_rate_to_scale+0x54
#     rockchip_adjust_opp_table / rockchip_cpufreq_adjust_table
#     dt_cpufreq_probe / rockchip_cpufreq_probe
#
# The damage was not the lost DVFS. The oops happened inside
# deferred_probe_work_func, so it killed the deferred-probe worker, and
# nothing still waiting on that worker - the SD card included - ever probed.
# A board that will not find its own root filesystem is not debuggable in
# place, which is why this was switched off rather than chased down.
#
# =m removes exactly that failure mode. rockchip-cpufreq has no
# MODULE_DEVICE_TABLE; it registers its own platform device from module_init.
# So nothing autoloads it, the boot path never touches it, and a probe that
# oopses takes down the insmod caller on an already-mounted rootfs instead of
# the machine. A power cycle returns to a working board because the module
# does not load on its own.
#
# Note the earlier diagnosis recorded here was that clk-pll.c's
# "if (!pll)" after a container_of() is dead code and that the CPU clock's
# parent was not a Rockchip PLL. The first half is true and still a latent
# bug. The second half does not hold on the current tree: with patch 0001
# pinning ARMCLKB/ARMCLKL, armclkl's parent is lpll and armclkb's is bpll,
# both of which are Rockchip PLLs. So the recorded cause is unproven, and
# the oops needs to be reproduced before anything is patched.
CONFIG_ARM_ROCKCHIP_CPUFREQ=m

# --- Wi-Fi: mainline brcmfmac instead of the vendor bcmdhd -----------------
# The module on this board is an AP6356S, i.e. a Broadcom BCM4356 on SDIO
# (`vendor=0x02d0 device=0x4356` under /sys/bus/sdio/devices). Two drivers
# can claim it, and rockchip_linux_defconfig picks the wrong one for us:
#
#   CONFIG_WL_ROCKCHIP + CONFIG_AP6XXX  the vendor bcmdhd fork, an Android
#                                       driver that never comes up here
#   CONFIG_BRCMFMAC                     mainline, and what every other
#                                       RK3399 + AP6356S board upstream uses
#
# bcmdhd does not just fail, it fails for reasons that cannot be configured
# away on this image:
#
#   [WLAN_RFKILL]: rockchip_wifi_get_oob_irq: rfkill-wlan driver has not
#                  Successful initialized
#   dhd_wlan_init_gpio: WL_HOST_WAKE=-1, oob_irq=-1
#   dhd_wlan_init_gpio: WL_REG_ON=-1
#   [dhd] sdioh_probe: bcmsdh_probe failed
#   bcmsdh_sdmmc mmc2:0001:2: probe with driver bcmsdh_sdmmc failed with -12
#   [dhd] dhd_wifi_platform_load_sdio: sdio_register_driver timeout or error
#
# It wants Rockchip's rfkill-wlan (CONFIG_RFKILL_RK), which needs a
# "wireless-wlan" device tree node holding WIFI_REG_ON and WIFI_HOST_WAKE
# gpios. Our DTS is the mainline-shaped one and has no such node - it has the
# mainline arrangement instead, and a correct one: dwmmc@fe310000 already
# carries cap-sdio-irq, non-removable, sd-uhs-sdr104, an mmc-pwrseq with the
# reset gpio, and a wifi@1 child with compatible = "brcm,bcm4329-fmac" and a
# host-wake interrupt. That is exactly what brcmfmac binds to. Nothing in the
# device tree needs changing; only the driver choice was wrong.
#
# The firmware is already on the image (linux-firmware ships
# brcmfmac4356-sdio.bin and .clm_blob). The NVRAM file is per board and
# brcmfmac looks it up by the root compatible, so we add the one name for
# this board - see overlay/usr/lib/firmware/brcm.
#
# =m rather than =y for the same reason as cpufreq above: a Wi-Fi driver is
# not on the path to mounting root, and a module can be unloaded and reloaded
# while debugging without a power cycle.
# CONFIG_WL_ROCKCHIP is not set
# CONFIG_AP6XXX is not set
# CONFIG_BCMDHD is not set
# =m for the same reason, and for one more of its own. cfg80211 is =y in the
# vendor defconfig, and built in it asks the firmware loader for
# regulatory.db during init - which on this image happens at about 5.8 s,
# while the initramfs is still the root filesystem and /lib/firmware does not
# have it yet:
#
#   platform regulatory.0: Direct firmware load for regulatory.db failed with error -2
#   cfg80211: failed to load regulatory.db
#
# There is no retry. The kernel then stays on the built-in world domain "00"
# for the life of the boot, and `iw reg set TW` is a no-op because there is no
# database to select from. What that costs is the 5 GHz DFS range - channels
# 52-144, 5250-5330 and 5490-5730 MHz - which nothing scans, so an AP on
# channel 108 does not exist as far as the board is concerned. Measured: every
# 5 GHz network the board could see was on 44, 48, 149, 157 or 165, with a
# clean hole in between, and a scan directed at the DFS channels alone
# returned nothing at all.
#
# As a module it loads off the real rootfs, after mount, and the regdb request
# succeeds. brcmfmac depends on it and is already =m, so nothing else moves.
# The other half of this fix is the wireless-regdb package - see
# build/docker/Dockerfile.rootfs.
CONFIG_CFG80211=m
CONFIG_BRCMUTIL=m
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_PROTO_BCDC=y
CONFIG_BRCMFMAC_SDIO=y
